<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Numéro de version : fichier VERSION à la racine (modifié par « Publier une mise a jour.bat ») -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Company>L'ICA</Company>
    <Product>L'ICA Gestion</Product>
    <Copyright>L'ICA</Copyright>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
