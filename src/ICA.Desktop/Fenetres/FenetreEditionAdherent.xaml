<Window x:Class="ICA.Desktop.Fenetres.FenetreEditionAdherent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Titre}" Icon="/Assets/ica.ico"
        Width="780" SizeToContent="Height" MaxHeight="940" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre intégrée -->
        <DockPanel Height="64" Margin="36,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonFermerFenetre}" VerticalAlignment="Top" Margin="0,-8,0,0"
                    Command="{Binding AnnulerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Fermer sans enregistrer" AutomationProperties.Name="Fermer">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
            </Button>
            <TextBlock Text="{Binding Titre}" Style="{StaticResource Titre1}" FontSize="28" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="36,20,36,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Type -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
                    <TextBlock Text="Type d'adhérent" Style="{StaticResource Libelle}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Adulte" Width="160" Margin="0,0,10,0" IsChecked="{Binding EstAdulte}" />
                        <RadioButton Style="{StaticResource Segment}" Content="Enfant" Width="160" IsChecked="{Binding EstEnfant}" />
                    </StackPanel>
                </StackPanel>

                <!-- Responsable (enfant) -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Fond}" CornerRadius="14" Padding="18,16" Margin="0,0,0,18"
                        Visibility="{Binding EstEnfant, Converter={StaticResource SiVrai}}">
                    <StackPanel>
                        <TextBlock Text="Adulte responsable" Style="{StaticResource Libelle}" />
                        <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding Responsables}" SelectedItem="{Binding Responsable}"
                                  DisplayMemberPath="Nom" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  AutomationProperties.Name="Adulte responsable" />
                        <TextBlock Text="{Binding ErreurResponsable}" Style="{StaticResource TexteErreur}"
                                   Visibility="{Binding ErreurResponsable, Converter={StaticResource SiRempli}}" />
                        <TextBlock Text="Tapez les premières lettres du nom. Son adresse sera reprise si celle de l'enfant est vide."
                                   Style="{StaticResource StyleTexteDiscret}" Margin="0,8,0,0" FontSize="14" />
                    </StackPanel>
                </Border>

                <!-- Identité -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Nom *" Style="{StaticResource Libelle}" />
                    <TextBox x:Name="PremierChamp" Style="{StaticResource Champ}" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom" />
                    <TextBlock Text="{Binding ErreurNom}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurNom, Converter={StaticResource SiRempli}}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Prénom *" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prénom" />
                    <TextBlock Text="{Binding ErreurPrenom}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurPrenom, Converter={StaticResource SiRempli}}" />
                </StackPanel>

                <!-- Adresse -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,16">
                    <TextBlock Text="Adresse" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}" Tag="Numéro et rue"
                             AutomationProperties.Name="Adresse" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding ComplementAdresse, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                             Tag="Complément (bâtiment, lieu-dit…) — facultatif" AutomationProperties.Name="Complément d'adresse" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Code postal" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                             AutomationProperties.Name="Code postal" />
                    <TextBlock Text="{Binding ErreurCodePostal}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurCodePostal, Converter={StaticResource SiRempli}}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Ville" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ville" />
                </StackPanel>

                <!-- Contact -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="Téléphone" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Telephone1, UpdateSourceTrigger=PropertyChanged}" Tag="06 12 34 56 78"
                             AutomationProperties.Name="Téléphone" />
                    <TextBlock Text="{Binding ErreurTelephone1}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurTelephone1, Converter={StaticResource SiRempli}}" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Téléphone secondaire" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Telephone2, UpdateSourceTrigger=PropertyChanged}" Tag="Facultatif"
                             AutomationProperties.Name="Téléphone secondaire" />
                    <TextBlock Text="{Binding ErreurTelephone2}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurTelephone2, Converter={StaticResource SiRempli}}" />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="E-mail" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Tag="prenom.nom@gmail.com"
                             AutomationProperties.Name="E-mail" />
                    <TextBlock Text="{Binding ErreurEmail}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurEmail, Converter={StaticResource SiRempli}}" />
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="Date de naissance" Style="{StaticResource Libelle}" />
                    <DatePicker Style="{StaticResource Date}" SelectedDate="{Binding DateNaissance}" AutomationProperties.Name="Date de naissance" />
                    <TextBlock Text="{Binding ErreurDateNaissance}" Style="{StaticResource TexteErreur}" Visibility="{Binding ErreurDateNaissance, Converter={StaticResource SiRempli}}" />
                </StackPanel>

                <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <StackPanel Visibility="{Binding AActivites, Converter={StaticResource SiVrai}}" Margin="0,0,0,16">
                        <TextBlock Text="Activités" Style="{StaticResource Libelle}" />
                        <ItemsControl ItemsSource="{Binding Inscriptions}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Fond}" CornerRadius="12" Padding="12,10" Margin="0,0,10,10">
                                        <CheckBox Style="{StaticResource Case}" IsChecked="{Binding EstCoche}" VerticalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Couleur}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Nom}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="Notes" Style="{StaticResource Libelle}" />
                    <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Informations utiles (facultatif)" AutomationProperties.Name="Notes" />
                </StackPanel>

                <Border Grid.Row="8" Grid.ColumnSpan="3" Background="#FDECEA" CornerRadius="12" Padding="16,12" Margin="0,8,0,0"
                        Visibility="{Binding AErreurGenerale, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="{Binding ErreurGenerale}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Boutons -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Padding="36,18" Background="{StaticResource Fond}"
                CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="140" Margin="0,0,12,0"
                        IsCancel="True" />
                <Button Style="{StaticResource BoutonPrincipal}" Content="{Binding TexteBouton}" Command="{Binding EnregistrerCommand}" MinWidth="220"
                        MinHeight="54" FontSize="17" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
