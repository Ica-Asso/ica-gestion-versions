<Window x:Class="ICA.Desktop.Fenetres.FenetreComposer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client"
        Title="Nouveau message" Icon="/Assets/ica.ico"
        Width="1040" Height="780" MinWidth="900" MinHeight="640" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <Grid x:Name="Racine">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Modèles ============ -->
        <Border Background="{StaticResource Fond}" BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,1,0" Padding="20,40,20,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Choisir un modèle" Style="{StaticResource Titre3}" Margin="6,0,0,14" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Modeles}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChoixModele}">
                                <Button Command="{Binding Choisir}" Margin="0,0,0,6" Cursor="Hand" AutomationProperties.Name="{Binding Nom}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fond" CornerRadius="10" MinHeight="48" Padding="14,0" Background="Transparent"
                                                    BorderThickness="2" BorderBrush="Transparent">
                                                <TextBlock x:Name="Texte" Text="{Binding Nom}" VerticalAlignment="Center" FontSize="16"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EstChoisi}" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="{StaticResource BordeauxClair}" />
                                                    <Setter TargetName="Texte" Property="Foreground" Value="{StaticResource Bordeaux}" />
                                                    <Setter TargetName="Texte" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Message ============ -->
        <Grid Grid.Column="1" Margin="36,40,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Nouveau message" Style="{StaticResource Titre1}" FontSize="28" />

            <!-- Destinataires -->
            <Border Grid.Row="1" Background="{StaticResource Fond}" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock>
                        <Run Text="À :" Foreground="{StaticResource TexteDiscret}" />
                        <Run Text="{Binding TitreDestinataires, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text="{Binding DetailDestinataires}" Style="{StaticResource StyleTexteDiscret}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding SansEmail}" Style="{StaticResource StyleTexteDiscret}" Foreground="{StaticResource Orange}"
                               Margin="0,6,0,0" Visibility="{Binding SansEmail, Converter={StaticResource SiRempli}}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="Objet" Style="{StaticResource Libelle}" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Objet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Objet" />
            </StackPanel>

            <DockPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Message" Style="{StaticResource Libelle}" />
                <TextBox x:Name="ChampCorps" Style="{StaticResource ChampMultiligne}" Text="{Binding Corps, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Message" />
            </DockPanel>

            <TextBlock Grid.Row="4" Text="{Binding AideVariables}" Style="{StaticResource StyleTexteDiscret}" Margin="2,8,0,0" />

            <DockPanel Grid.Row="5" Margin="0,18,0,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Expediteur}" Style="{StaticResource StyleTexteDiscret}" VerticalAlignment="Center"
                           Visibility="{Binding EnvoiDirect, Converter={StaticResource SiVrai}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="130"
                            Margin="0,0,12,0" IsCancel="True" />
                    <!-- Compte Google connecté : envoi direct ; ouvrir dans Gmail reste possible (pièce jointe…) -->
                    <Button Style="{StaticResource BoutonSecondaire}" Content="{Binding TexteOuvrir}" Command="{Binding OuvrirCommand}" Margin="0,0,12,0"
                            FontWeight="Bold" Visibility="{Binding EnvoiDirect, Converter={StaticResource SiVrai}}" />
                    <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding EnvoyerCommand}" MinHeight="54" FontSize="17" Padding="22,0"
                            Visibility="{Binding EnvoiDirect, Converter={StaticResource SiVrai}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.envoyer}" Style="{StaticResource Icone}" StrokeThickness="2.2" />
                            <TextBlock Text="{Binding TexteEnvoyer}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Sans compte Google : ouverture dans la messagerie -->
                    <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding OuvrirCommand}" MinHeight="54" FontSize="17" Padding="22,0"
                            Visibility="{Binding PasEnvoiDirect, Converter={StaticResource SiVrai}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.envoyer}" Style="{StaticResource Icone}" StrokeThickness="2.2" />
                            <TextBlock Text="{Binding TexteOuvrir}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Boutons de fenêtre -->
        <Button Grid.Column="1" Style="{StaticResource BoutonFermerFenetre}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Command="{Binding AnnulerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fermer">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
        </Button>
    </Grid>
</Window>
