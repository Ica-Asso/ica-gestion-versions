<Window x:Class="ICA.Desktop.Fenetres.FenetreImport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client"
        Title="Importer mes adhérents" Icon="/Assets/ica.ico"
        Width="1000" Height="800" MinWidth="860" MinHeight="600" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Grid.RowSpan="3" Style="{StaticResource BoutonFermerFenetre}" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                Command="{Binding AnnulerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fermer">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
        </Button>

        <!-- En-tête et résumé -->
        <StackPanel Margin="36,40,36,0">
            <TextBlock Text="Importer mes adhérents" Style="{StaticResource Titre1}" FontSize="28" />
            <TextBlock Style="{StaticResource StyleTexteDiscret}" FontSize="16" Margin="0,4,0,0">
                <Run Text="Fichier :" />
                <Run Text="{Binding NomFichier, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <Border Background="#FDECEA" CornerRadius="12" Padding="18,14" Margin="0,18,0,0"
                    Visibility="{Binding AErreur, Converter={StaticResource SiVrai}}">
                <TextBlock Text="{Binding Erreur}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="16" />
            </Border>

            <StackPanel Visibility="{Binding Analyse, Converter={StaticResource SiVrai}}">
                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <Border Style="{StaticResource StyleCarte}" Background="{StaticResource Fond}" Margin="0,0,12,0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Detectes}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Bordeaux}" />
                            <TextBlock Text="adhérents détectés" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StyleCarte}" Background="{StaticResource VertClair}" BorderThickness="0" Margin="6,0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Prets}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Vert}" />
                            <TextBlock Text="lignes prêtes" FontWeight="SemiBold" Foreground="{StaticResource Vert}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StyleCarte}" Background="{StaticResource OrangeClair}" BorderBrush="{StaticResource OrangeBordure}"
                            BorderThickness="2" Margin="12,0,0,0" Padding="19,15">
                        <StackPanel>
                            <TextBlock Text="{Binding AVerifier}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource OrangeVif}" />
                            <TextBlock Text="lignes à vérifier" FontWeight="Bold" Foreground="{StaticResource Orange}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="{Binding Precisions}" Style="{StaticResource StyleTexteDiscret}" FontSize="16" Margin="2,10,0,0" />
                <ItemsControl ItemsSource="{Binding Colonnes}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Fond}" CornerRadius="999" Padding="12,4" Margin="0,0,8,6">
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource TexteSecondaire}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,10,0,8">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Case}" IsChecked="{Binding SeulementAVerifier}" VerticalContentAlignment="Center">
                        <TextBlock Text="Seulement les lignes à vérifier" FontWeight="SemiBold" />
                    </CheckBox>
                    <TextBlock Text="Aperçu" Style="{StaticResource Titre2}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <!-- Lignes -->
        <ScrollViewer Grid.Row="1" Margin="36,0,36,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding Analyse, Converter={StaticResource SiVrai}}">
            <ItemsControl ItemsSource="{Binding Lignes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LigneApercuImport}">
                        <Border x:Name="Cadre" BorderBrush="{StaticResource Separateur}" BorderThickness="0,1,0,0" Padding="10,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Numero}" Width="78" Foreground="{StaticResource TexteDiscret}" FontSize="14"
                                           VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Nom}" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                                    <TextBlock Text="{Binding Remarques, StringFormat='⚠ {0}'}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource Orange}" Visibility="{Binding Remarques, Converter={StaticResource SiRempli}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding AVerifier}" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource OrangeClair}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bas : options et boutons -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Padding="36,16" Background="{StaticResource Fond}"
                CornerRadius="0,0,8,8">
            <StackPanel>
                <StackPanel Visibility="{Binding Analyse, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="{Binding Explication}" Style="{StaticResource StyleTexteDiscret}" Margin="0,0,0,10" />
                    <CheckBox Style="{StaticResource Case}" IsChecked="{Binding Remplacer}" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TexteRemplacer}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="140" Margin="0,0,12,0"
                            IsCancel="True" />
                    <Button Style="{StaticResource BoutonPrincipal}" Content="{Binding TexteBouton}" Command="{Binding ImporterCommand}" MinWidth="240"
                            MinHeight="54" FontSize="17" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
