<Window x:Class="ICA.Desktop.Fenetres.FenetreMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L'ICA Gestion" Icon="/Assets/ica.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <StackPanel Margin="36,40,36,30">
        <TextBlock x:Name="TexteTitre" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="TexteMessage" FontSize="17" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource TexteSecondaire}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button x:Name="BoutonNon" Style="{StaticResource BoutonSecondaire}" Content="Annuler" MinWidth="130" Margin="0,0,12,0"
                    IsCancel="True" Click="Non" />
            <Button x:Name="BoutonOui" Style="{StaticResource BoutonPrincipal}" Content="OK" MinWidth="150" IsDefault="True" Click="Oui" />
        </StackPanel>
    </StackPanel>
</Window>
