<Window x:Class="ICA.Desktop.Fenetres.FenetreAssistance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Un problème ?" Icon="/Assets/ica.ico"
        Width="720" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <Grid>
        <Button Style="{StaticResource BoutonFermerFenetre}" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                Command="{Binding FermerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fermer">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="44,44,44,36">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource BordeauxClair}">
                        <Path Data="{StaticResource Ico.aide}" Style="{StaticResource Icone}" Width="30" Height="30" Stroke="{StaticResource Bordeaux}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock Text="{Binding Titre}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SousTitre}" Style="{StaticResource StyleTexteDiscret}" FontSize="16" />
                    </StackPanel>
                </StackPanel>

                <!-- Saisie -->
                <StackPanel Visibility="{Binding PasEnvoye, Converter={StaticResource SiVrai}}">
                    <TextBlock Margin="0,26,0,8" FontSize="17">
                        <Run Text="Que s'est-il passé ?" FontWeight="Bold" />
                        <Run Text="Quelques mots suffisent, c'est facultatif." Foreground="{StaticResource TexteDiscret}" FontSize="15" />
                    </TextBlock>
                    <TextBox x:Name="ChampMessage" Style="{StaticResource ChampMultiligne}" MinHeight="140"
                             Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Exemple : quand je clique sur « Marquer payée », rien ne se passe."
                             AutomationProperties.Name="Que s'est-il passé ?" />

                    <CheckBox Style="{StaticResource Case}" IsChecked="{Binding JoindreCapture}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Joindre une capture de l'écran" FontWeight="Bold" />
                            <TextBlock Text="Utile pour comprendre, mais elle peut montrer des informations sur des adhérents."
                                       Style="{StaticResource StyleTexteDiscret}" />
                        </StackPanel>
                    </CheckBox>

                    <Border Background="{StaticResource Fond}" CornerRadius="12" Padding="18,16" Margin="0,20,0,0">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource Ico.bouclier}" Style="{StaticResource Icone}" Stroke="{StaticResource Vert}"
                                  VerticalAlignment="Top" Margin="0,2,14,0" />
                            <StackPanel>
                                <TextBlock Text="Ajouté automatiquement pour aider au dépannage" FontWeight="Bold" FontSize="15" />
                                <TextBlock Style="{StaticResource StyleTexteDiscret}" Foreground="{StaticResource TexteSecondaire}" Margin="0,4,0,0"
                                           Text="Version de l'application, version de Windows, état de la synchronisation et dernières erreurs techniques. Aucune donnée d'adhérent n'est envoyée." />
                                <Button Style="{StaticResource BoutonLien}" Content="{Binding TexteApercu}" Command="{Binding BasculerApercuCommand}"
                                        FontSize="15" Margin="-4,6,0,0" HorizontalAlignment="Left" />
                                <TextBox Text="{Binding Apercu, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                         TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                         Padding="10" BorderBrush="{StaticResource Bordure}" Background="White"
                                         Visibility="{Binding ApercuVisible, Converter={StaticResource SiVrai}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding EnvoyerCommand}" MinHeight="58" FontSize="18">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Ico.envoyer}" Style="{StaticResource Icone}" StrokeThickness="2.2" />
                                <TextBlock Text="Envoyer au support" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BoutonSecondaire}" Content="Annuler" MinHeight="58" FontSize="17"
                                Command="{Binding FermerCommand}" IsCancel="True" />
                    </Grid>
                </StackPanel>

                <!-- Confirmation -->
                <StackPanel Visibility="{Binding Envoye, Converter={StaticResource SiVrai}}">
                    <Border Background="{StaticResource VertClair}" CornerRadius="14" Padding="20,18" Margin="0,26,0,0">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource Ico.valider}" Style="{StaticResource Icone}" Stroke="{StaticResource Vert}"
                                  StrokeThickness="2.6" VerticalAlignment="Top" Margin="0,2,14,0" />
                            <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" FontSize="17" Foreground="{StaticResource Vert}" FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>
                    <Button Style="{StaticResource BoutonPrincipal}" Content="Fermer" Command="{Binding FermerCommand}" Margin="0,22,0,0"
                            HorizontalAlignment="Right" MinWidth="160" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
