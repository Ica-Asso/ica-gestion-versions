<Window x:Class="ICA.Desktop.Fenetres.FenetreActivite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client"
        Title="{Binding TitreFenetre}" Icon="/Assets/ica.ico"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <Grid>
        <Button Style="{StaticResource BoutonFermerFenetre}" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                Command="{Binding AnnulerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fermer">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
        </Button>
        <StackPanel Margin="36,44,36,28">
            <TextBlock Text="{Binding TitreFenetre}" Style="{StaticResource Titre1}" FontSize="28" />

            <TextBlock Text="Nom de l'activité *" Style="{StaticResource Libelle}" Margin="0,22,0,6" />
            <TextBox x:Name="ChampNom" Style="{StaticResource Champ}" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" Tag="Exemple : Tricot"
                     AutomationProperties.Name="Nom de l'activité" />

            <TextBlock Text="Description" Style="{StaticResource Libelle}" Margin="0,16,0,6" />
            <TextBox Style="{StaticResource Champ}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Exemple : le lundi après-midi, débutants bienvenus" AutomationProperties.Name="Description" />

            <TextBlock Text="Couleur dans le calendrier" Style="{StaticResource Libelle}" Margin="0,16,0,8" />
            <ItemsControl ItemsSource="{Binding Couleurs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OptionCouleur}">
                        <Button Command="{Binding Choisir}" Margin="0,0,10,0" Cursor="Hand" AutomationProperties.Name="{Binding Hex}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Anneau" Width="46" Height="46" CornerRadius="23" BorderThickness="3" BorderBrush="Transparent">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Hex}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Anneau" Property="BorderBrush" Value="{StaticResource BordureForte}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding EstChoisie}" Value="True">
                                            <Setter TargetName="Anneau" Property="BorderBrush" Value="{StaticResource Texte}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#FDECEA" CornerRadius="12" Padding="16,12" Margin="0,14,0,0"
                    Visibility="{Binding AErreur, Converter={StaticResource SiVrai}}">
                <TextBlock Text="{Binding Erreur}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <DockPanel Margin="0,26,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource BoutonDanger}" Content="Archiver l'activité" Command="{Binding ArchiverCommand}"
                        Visibility="{Binding PeutArchiver, Converter={StaticResource SiVrai}}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="130"
                            Margin="0,0,12,0" IsCancel="True" />
                    <Button Style="{StaticResource BoutonPrincipal}" Content="Enregistrer" Command="{Binding EnregistrerCommand}" MinWidth="170"
                            IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
