<Window x:Class="ICA.Desktop.Fenetres.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client"
        xmlns:vues="clr-namespace:ICA.Desktop.Vues"
        Title="L'ICA Gestion"
        Icon="/Assets/ica.ico"
        Width="1320" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource FenetreIca}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AccueilViewModel}">
            <vues:VueAccueil />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdherentsViewModel}">
            <vues:VueAdherents />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CotisationsViewModel}">
            <vues:VueCotisations />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivitesViewModel}">
            <vues:VueActivites />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParametresViewModel}">
            <vues:VueParametres />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DonsViewModel}">
            <vues:VueDons />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MessagerieViewModel}">
            <vues:VueMessagerie />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageEnPreparationViewModel}">
            <vues:VueEnPreparation />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Racine" Background="{StaticResource Fond}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= Menu latéral ================= -->
            <Border Grid.Column="0" Background="{StaticResource Carte}" BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,1,0" Padding="16,22,16,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,0">
                        <Image Source="/Assets/logo-ica.jpg" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="L'ICA Gestion" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Bordeaux}" />
                            <TextBlock Text="Partageons nos savoirs-faire" FontSize="13" Foreground="{StaticResource TexteDiscret}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" Margin="0,26,0,0" ItemsSource="{Binding Navigation}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ElementNavigation}">
                                <Button Command="{Binding DataContext.NaviguerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}" Margin="0,0,0,4" Cursor="Hand"
                                        AutomationProperties.Name="{Binding Libelle}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fond" CornerRadius="10" MinHeight="50" Padding="14,0" Background="Transparent"
                                                    BorderThickness="2" BorderBrush="Transparent">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path x:Name="Icone" Data="{Binding Id, Converter={StaticResource IdVersIcone}}"
                                                          Style="{StaticResource Icone}" Stroke="{StaticResource TexteSecondaire}" />
                                                    <TextBlock x:Name="Texte" Text="{Binding Libelle}" Margin="14,0,0,0" FontSize="17"
                                                               FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="{StaticResource Survol}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EstActif}" Value="True">
                                                    <Setter TargetName="Fond" Property="Background" Value="{StaticResource BordeauxClair}" />
                                                    <Setter TargetName="Icone" Property="Stroke" Value="{StaticResource Bordeaux}" />
                                                    <Setter TargetName="Texte" Property="Foreground" Value="{StaticResource Bordeaux}" />
                                                    <Setter TargetName="Texte" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bas du menu : état + assistance -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="{StaticResource BordeauxClair}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                                Visibility="{Binding MiseAJourDisponible, Converter={StaticResource SiVrai}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TitreMiseAJour}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Bordeaux}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding MettreAJourCommand}" Margin="0,8,0,0" MinHeight="40" FontSize="15">
                                    <TextBlock Text="{Binding TexteBoutonMiseAJour}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource VertClair}" CornerRadius="10" Padding="14,10" ToolTip="{Binding EtatDetail}"
                                Visibility="{Binding VoyantVert, Converter={StaticResource SiVrai}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource VertVif}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EtatTexte}" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Vert}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource OrangeClair}" CornerRadius="10" Padding="14,10" ToolTip="{Binding EtatDetail}"
                                Visibility="{Binding VoyantOrange, Converter={StaticResource SiVrai}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource OrangeVif}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EtatTexte}" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Orange}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#FDECEA" CornerRadius="10" Padding="14,10" ToolTip="{Binding EtatDetail}"
                                Visibility="{Binding VoyantRouge, Converter={StaticResource SiVrai}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EtatTexte}" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding AssistanceCommand}" Style="{StaticResource BoutonSecondaire}" Margin="0,10,0,0"
                                HorizontalContentAlignment="Left" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Ico.aide}" Style="{StaticResource Icone}" Stroke="{StaticResource Bordeaux}" />
                                <TextBlock Text="Un problème ?" Margin="12,0,0,0" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Contenu ================= -->
            <ContentControl Grid.Column="1" Content="{Binding PageCourante}" Focusable="False" />

            <!-- ================= Boutons de fenêtre ================= -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BoutonFenetre}" Click="Reduire" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Réduire" AutomationProperties.Name="Réduire la fenêtre">
                    <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource BoutonFenetre}" Click="AgrandirRestaurer" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Agrandir" AutomationProperties.Name="Agrandir la fenêtre">
                    <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               StrokeThickness="1" />
                </Button>
                <Button Style="{StaticResource BoutonFermerFenetre}" Click="Fermer" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Fermer" AutomationProperties.Name="Fermer L'ICA Gestion">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
