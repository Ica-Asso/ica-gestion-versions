<Window x:Class="ICA.Desktop.Fenetres.FenetrePlanification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client"
        Title="{Binding TitreFenetre}" Icon="/Assets/ica.ico"
        Width="720" SizeToContent="Height" MaxHeight="940" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Height="64" Margin="36,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonFermerFenetre}" VerticalAlignment="Top" Margin="0,-8,0,0"
                    Command="{Binding AnnulerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fermer">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
            </Button>
            <TextBlock Text="{Binding TitreFenetre}" Style="{StaticResource Titre1}" FontSize="28" VerticalAlignment="Bottom" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="36,20,36,8">
                <TextBlock Text="Activité" Style="{StaticResource Libelle}" />
                <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding Options}" SelectedItem="{Binding Activite}"
                          AutomationProperties.Name="Activité">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OptionActivite}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Fill="{Binding Couleur}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Nom}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{Binding LibelleTitre}" Style="{StaticResource Libelle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Titre, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding IndicationTitre}" AutomationProperties.Name="Nom ou précision" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Date" Style="{StaticResource Libelle}" />
                        <DatePicker Style="{StaticResource Date}" SelectedDate="{Binding Date}" AutomationProperties.Name="Date" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Début" Style="{StaticResource Libelle}" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding HeureDebut, UpdateSourceTrigger=PropertyChanged}" Tag="14h00"
                                 AutomationProperties.Name="Heure de début" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Fin" Style="{StaticResource Libelle}" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding HeureFin, UpdateSourceTrigger=PropertyChanged}" Tag="17h00"
                                 AutomationProperties.Name="Heure de fin" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Lieu" Style="{StaticResource Libelle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Lieu, UpdateSourceTrigger=PropertyChanged}" Tag="Salle de L'ICA"
                         AutomationProperties.Name="Lieu" />

                <!-- Répétition (création uniquement) -->
                <Border Background="{StaticResource Fond}" CornerRadius="14" Padding="18,16" Margin="0,18,0,0"
                        Visibility="{Binding EstNouvelle, Converter={StaticResource SiVrai}}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Case}" IsChecked="{Binding Repeter}">
                            <TextBlock Text="Répéter chaque semaine" FontWeight="Bold" />
                        </CheckBox>
                        <StackPanel Visibility="{Binding Repeter, Converter={StaticResource SiVrai}}" Margin="36,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Jusqu'au" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                                <DatePicker Style="{StaticResource Date}" SelectedDate="{Binding RepeterJusquau}" Width="200"
                                            AutomationProperties.Name="Répéter jusqu'au" />
                            </StackPanel>
                            <TextBlock Text="{Binding ResumeRepetition}" Style="{StaticResource StyleTexteDiscret}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Notes" Style="{StaticResource Libelle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" MinHeight="80" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Matériel à prévoir, intervenant… (facultatif)" AutomationProperties.Name="Notes" />

                <Border Background="#FDECEA" CornerRadius="12" Padding="16,12" Margin="0,14,0,0"
                        Visibility="{Binding AErreur, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="{Binding Erreur}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" Padding="36,18" Background="{StaticResource Fond}"
                CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="140" Margin="0,0,12,0"
                        IsCancel="True" />
                <Button Style="{StaticResource BoutonPrincipal}" Content="{Binding TexteBouton}" Command="{Binding EnregistrerCommand}" MinWidth="220"
                        MinHeight="54" FontSize="17" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
