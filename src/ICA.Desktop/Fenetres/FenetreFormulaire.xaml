<Window x:Class="ICA.Desktop.Fenetres.FenetreFormulaire"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client"
        Title="{Binding TitreFenetre}" Icon="/Assets/ica.ico"
        Width="680" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FenetreIca}" Background="{StaticResource Carte}">

    <Window.Resources>
        <!-- ================= Entreprise ================= -->
        <DataTemplate DataType="{x:Type vm:EditionEntrepriseViewModel}">
            <StackPanel>
                <TextBlock Text="L'entreprise" Style="{StaticResource Titre3}" Margin="0,0,0,10" />
                <TextBlock Text="Raison sociale *" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding RaisonSociale, UpdateSourceTrigger=PropertyChanged}" Tag="Exemple : Boulangerie Martin"
                         AutomationProperties.Name="Raison sociale" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Forme juridique" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding FormesJuridiques}" SelectedItem="{Binding FormeJuridique}"
                                  AutomationProperties.Name="Forme juridique" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="N° SIREN (9 chiffres)" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding NumeroSiren, UpdateSourceTrigger=PropertyChanged}" Tag="123 456 789"
                                 AutomationProperties.Name="Numéro SIREN" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="N° SIRET (facultatif)" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding NumeroSiret, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Numéro SIRET" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding FormeAutreVisible, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="Précisez la forme juridique" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding FormeAutre, UpdateSourceTrigger=PropertyChanged}" Tag="Exemple : SCA, coopérative…"
                             AutomationProperties.Name="Forme juridique précisée" />
                </StackPanel>
                <TextBlock Text="Adresse (numéro et rue)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adresse" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Code postal" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Code postal" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ville" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ville" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="La personne à contacter dans l'entreprise" Style="{StaticResource Titre3}" Margin="0,26,0,0" />
                <TextBlock Text="C'est à cette personne que les justificatifs sont envoyés par e-mail." Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Prénom" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding ContactPrenom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prénom du contact" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nom" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding ContactNom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom du contact" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Adresse e-mail" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding EmailEntreprise, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Téléphone" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding TelephoneEntreprise, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Téléphone" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Notes internes" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="70" AutomationProperties.Name="Notes" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="130" Margin="0,0,12,0" IsCancel="True" />
                    <Button Style="{StaticResource BoutonPrincipal}" Content="Enregistrer" Command="{Binding EnregistrerCommand}" MinWidth="170" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ================= Don ================= -->
        <DataTemplate DataType="{x:Type vm:EditionDonViewModel}">
            <StackPanel>
                <Border Background="{StaticResource OrangeClair}" BorderBrush="{StaticResource OrangeBordure}" BorderThickness="1" CornerRadius="10"
                        Padding="14,10" Margin="0,0,0,14" Visibility="{Binding AAvertissement, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="{Binding AvertissementJustificatif}" Foreground="{StaticResource Orange}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Entreprise *" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonSecondaire}" Content="Nouvelle entreprise…" Command="{Binding NouvelleEntrepriseCommand}"
                            Margin="12,0,0,0" FontWeight="Bold" />
                    <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding Entreprises}" SelectedItem="{Binding Entreprise}" DisplayMemberPath="RaisonSociale"
                              IsTextSearchEnabled="True" TextSearch.TextPath="RaisonSociale" AutomationProperties.Name="Entreprise" />
                </DockPanel>
                <TextBlock Text="L'annuaire est vide : ajoutez d'abord l'entreprise avec « Nouvelle entreprise… »." Style="{StaticResource StyleTexteDiscret}"
                           Margin="0,6,0,0" Visibility="{Binding AucuneEntreprise, Converter={StaticResource SiVrai}}" />

                <TextBlock Text="Type de don *" Style="{StaticResource Libelle}" Margin="0,16,0,8" />
                <WrapPanel>
                    <RadioButton Style="{StaticResource Segment}" Content="Don financier" Width="200" Margin="0,0,10,0" IsChecked="{Binding EstFinancier}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Don en nature" Width="200" Margin="0,0,10,0" IsChecked="{Binding EstNature}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Compétences / prestation" Width="230" IsChecked="{Binding EstCompetences}" />
                </WrapPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Date du don *" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <DatePicker Style="{StaticResource Date}" SelectedDate="{Binding Date}" AutomationProperties.Name="Date du don" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding LibelleMontant}" Style="{StaticResource Libelle}" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding Montant, UpdateSourceTrigger=PropertyChanged}" Tag="Exemple : 150"
                                 AutomationProperties.Name="Montant" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Visibility="{Binding EstFinancier, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="Mode de versement *" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" DisplayMemberPath="Libelle"
                                  AutomationProperties.Name="Mode de versement" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding AideMontant}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding PasFinancier, Converter={StaticResource SiVrai}}" />

                <TextBlock Text="{Binding LibelleDescription}" Style="{StaticResource Libelle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="60"
                         AutomationProperties.Name="Description" />

                <StackPanel Visibility="{Binding EstNature, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="Quantités (exemple : 10 chaises, 2 tables)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Quantites, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantités" />
                </StackPanel>
                <StackPanel Visibility="{Binding EstCompetences, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="Salariés mis à disposition (nombre, durée, qualification)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Salaries, UpdateSourceTrigger=PropertyChanged}" MinHeight="50"
                             AutomationProperties.Name="Salariés mis à disposition" />
                </StackPanel>
                <StackPanel Visibility="{Binding PasFinancier, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="Justificatifs fournis par l'entreprise (facture, attestation de valeur…)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding Pieces, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pièces justificatives" />
                </StackPanel>

                <TextBlock Text="Statut" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding Statuts}" SelectedItem="{Binding Statut}" DisplayMemberPath="Libelle" Width="260"
                          HorizontalAlignment="Left" AutomationProperties.Name="Statut" />

                <DockPanel Margin="0,24,0,0">
                    <Button DockPanel.Dock="Left" Style="{StaticResource BoutonDanger}" Content="Supprimer ce don" Command="{Binding SupprimerCommand}"
                            VerticalAlignment="Center" Visibility="{Binding PeutSupprimer, Converter={StaticResource SiVrai}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="130" Margin="0,0,12,0" IsCancel="True" />
                        <Button Style="{StaticResource BoutonPrincipal}" Content="Enregistrer le don" Command="{Binding EnregistrerCommand}" MinWidth="190" IsDefault="True" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ================= Générer un justificatif ================= -->
        <DataTemplate DataType="{x:Type vm:GenerationJustificatifViewModel}">
            <StackPanel>
                <TextBlock FontSize="17">
                    <Run Text="{Binding Entreprise, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{Binding Annee, Mode=OneWay, StringFormat='— dons de {0}'}" Foreground="{StaticResource TexteSecondaire}" />
                </TextBlock>

                <TextBlock Text="Document" Style="{StaticResource Libelle}" Margin="0,18,0,8" />
                <StackPanel IsEnabled="{Binding TypeModifiable}">
                    <RadioButton Style="{StaticResource Segment}" Content="Attestation simple" Width="260" HorizontalAlignment="Left" IsChecked="{Binding EstAttestation}" />
                    <TextBlock Text="{Binding TexteAttestation}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" Margin="4,4,0,10" TextWrapping="Wrap" />
                    <RadioButton Style="{StaticResource Segment}" Content="Reçu fiscal (2041-MEC-SD)" Width="260" HorizontalAlignment="Left"
                                 IsChecked="{Binding EstRecuFiscal}" IsEnabled="{Binding RecuFiscalPossible}" />
                    <TextBlock Text="{Binding TexteRecuFiscal}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" Margin="4,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="Dons à inclure (même entreprise, même année)" Style="{StaticResource Libelle}" Margin="0,18,0,8" />
                <ItemsControl ItemsSource="{Binding Dons}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChoixDon}">
                            <CheckBox Style="{StaticResource Case}" IsChecked="{Binding Coche}" Margin="0,0,0,8" VerticalContentAlignment="Top">
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Libelle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{StaticResource Fond}" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Total}" FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding TexteNumerotation}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="130" Margin="0,0,12,0" IsCancel="True" />
                    <Button Style="{StaticResource BoutonPrincipal}" Content="Générer le justificatif" Command="{Binding GenererCommand}" MinWidth="210" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ================= Envoyer un justificatif ================= -->
        <DataTemplate DataType="{x:Type vm:EnvoiJustificatifViewModel}">
            <StackPanel>
                <Border Background="{StaticResource OrangeClair}" BorderBrush="{StaticResource OrangeBordure}" BorderThickness="1" CornerRadius="10"
                        Padding="14,10" Margin="0,0,0,14" Visibility="{Binding ADejaEnvoye, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="{Binding DejaEnvoye}" Foreground="{StaticResource Orange}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="À" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Destinataire, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destinataire" />
                <TextBlock Text="Objet" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Objet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Objet" />
                <TextBlock Text="Message" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Corps, UpdateSourceTrigger=PropertyChanged}" MinHeight="220"
                         AutomationProperties.Name="Message" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Path Data="{StaticResource Ico.cotisations}" Style="{StaticResource Icone}" Stroke="{StaticResource Bordeaux}" />
                    <TextBlock Text="{Binding PieceJointe}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <DockPanel Margin="0,24,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Expediteur}" Style="{StaticResource StyleTexteDiscret}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="120" Margin="0,0,12,0" IsCancel="True" />
                        <Button Style="{StaticResource BoutonSecondaire}" Content="Préparer dans ma messagerie" Command="{Binding PreparerCommand}" Margin="0,0,12,0"
                                FontWeight="Bold" />
                        <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding EnvoyerCommand}" MinWidth="150"
                                Visibility="{Binding EnvoiDirect, Converter={StaticResource SiVrai}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Ico.envoyer}" Style="{StaticResource Icone}" StrokeThickness="2.2" />
                                <TextBlock Text="Envoyer" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ================= Association et statut fiscal ================= -->
        <DataTemplate DataType="{x:Type vm:EditionAssociationViewModel}">
            <StackPanel>
                <TextBlock Text="Ces informations figurent sur les attestations et les reçus. Elles sont partagées entre vos ordinateurs."
                           Style="{StaticResource StyleTexteDiscret}" FontSize="15" TextWrapping="Wrap" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nom officiel *" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding Denomination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dénomination" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="N° SIREN" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding NumeroSiren, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SIREN de l'association" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="N° RNA (W…)" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding Rna, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="RNA" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Adresse (numéro et rue)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource Champ}" Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Adresse de l'association" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Code postal" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Code postal" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ville" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ville" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="E-mail" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding EmailAsso, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail de l'association" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Objet de l'association" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Objet, UpdateSourceTrigger=PropertyChanged}" MinHeight="50" AutomationProperties.Name="Objet" />
                <TextBlock Text="Catégorie fiscale justifiant l'éligibilité (case cochée sur le reçu)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <ComboBox Style="{StaticResource Liste}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Categorie}" DisplayMemberPath="Libelle"
                          AutomationProperties.Name="Catégorie fiscale" />
                <StackPanel Visibility="{Binding AvecPrecision, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="Précisez la catégorie" Style="{StaticResource Libelle}" Margin="0,10,0,6" />
                    <TextBox Style="{StaticResource Champ}" Text="{Binding CategoriePrecision, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Précision de la catégorie" />
                </StackPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Signataire habilité" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding SignataireNom, UpdateSourceTrigger=PropertyChanged}" Tag="Prénom NOM" AutomationProperties.Name="Signataire" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fonction" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding SignataireQualite, UpdateSourceTrigger=PropertyChanged}" Tag="Présidente"
                                 AutomationProperties.Name="Qualité du signataire" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Lieu de signature" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding LieuSignature, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lieu de signature" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource Fond}" CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BoutonSecondaire}" Content="Choisir l'image…" Command="{Binding ChoisirSignatureCommand}" FontWeight="Bold" Margin="0,0,8,0" />
                            <Button Style="{StaticResource BoutonDanger}" Content="Retirer" Command="{Binding RetirerSignatureCommand}" FontSize="14"
                                    Visibility="{Binding ASignature, Converter={StaticResource SiVrai}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Signature du représentant habilité" FontWeight="Bold" />
                            <TextBlock Text="{Binding TexteSignature}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Statut fiscal de L'ICA (mécénat)" Style="{StaticResource Titre3}" Margin="0,22,0,8" />
                <WrapPanel>
                    <RadioButton Style="{StaticResource Segment}" Content="Non vérifiée" Width="190" Margin="0,0,10,0" IsChecked="{Binding NonVerifiee}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Confirmée" Width="190" Margin="0,0,10,0" IsChecked="{Binding Confirmee}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Non confirmée / désactivée" Width="250" IsChecked="{Binding Desactivee}" />
                </WrapPanel>
                <Border Background="{StaticResource OrangeClair}" BorderBrush="{StaticResource OrangeBordure}" BorderThickness="1" CornerRadius="10"
                        Padding="14,10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TexteAvertissement}" Foreground="{StaticResource Orange}" FontSize="14" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Rescrit mécénat (si l'association en a obtenu un)" Style="{StaticResource Titre3}" Margin="0,18,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Référence du rescrit" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Champ}" Text="{Binding ReferenceRescrit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Référence du rescrit" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date de la réponse" Style="{StaticResource Libelle}" Margin="0,0,0,6" />
                        <DatePicker Style="{StaticResource Date}" SelectedDate="{Binding DateRescrit}" AutomationProperties.Name="Date du rescrit" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Pièces justificatives (courrier de l'administration, statuts, où sont rangés les originaux…)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding PiecesRescrit, UpdateSourceTrigger=PropertyChanged}" MinHeight="50"
                         AutomationProperties.Name="Pièces justificatives du rescrit" />
                <TextBlock Text="Éléments justifiant l'éligibilité (sans rescrit : activité non lucrative, gestion désintéressée, public ouvert…)" Style="{StaticResource Libelle}" Margin="0,14,0,6" />
                <TextBox Style="{StaticResource ChampMultiligne}" Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" MinHeight="50"
                         AutomationProperties.Name="Justification de l'éligibilité" />

                <TextBlock Text="Vérification du modèle de reçu" Style="{StaticResource Titre3}" Margin="0,22,0,8" />
                <Border Background="{StaticResource Fond}" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="14">
                            <Run Text="Avant le premier vrai reçu : générez le spécimen (filigrane « SPÉCIMEN — NON VALABLE ») et comparez chaque rubrique au formulaire officiel" />
                            <Run Text="{Binding ModeleEnVigueur, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=". Les reçus fiscaux restent bloqués tant que cette vérification n'est pas cochée." />
                        </TextBlock>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource BoutonSecondaire}" Content="Générer le spécimen" Command="{Binding SpecimenCommand}"
                                    FontWeight="Bold" Margin="0,0,16,0" />
                            <CheckBox Style="{StaticResource Case}" IsChecked="{Binding SpecimenVerifie}" VerticalAlignment="Center">
                                <TextBlock Text="J'ai vérifié le spécimen rubrique par rubrique" TextWrapping="Wrap" Margin="8,0,0,0" />
                            </CheckBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Annuler" Command="{Binding AnnulerCommand}" MinWidth="130" Margin="0,0,12,0" IsCancel="True" />
                    <Button Style="{StaticResource BoutonPrincipal}" Content="Enregistrer" Command="{Binding EnregistrerCommand}" MinWidth="170" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Button Style="{StaticResource BoutonFermerFenetre}" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"
                Command="{Binding AnnulerCommand}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Fermer">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="36,44,36,28">
                <TextBlock Text="{Binding TitreFenetre}" Style="{StaticResource Titre1}" FontSize="28" Margin="0,0,0,20" />
                <Border Background="#FDECEA" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                        Visibility="{Binding AErreur, Converter={StaticResource SiVrai}}">
                    <TextBlock Text="{Binding Erreur}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
                <ContentControl Content="{Binding}" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
