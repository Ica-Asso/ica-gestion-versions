<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Police">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ===================== Textes ===================== -->
    <Style x:Key="Titre1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
    </Style>
    <Style x:Key="Titre2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
    </Style>
    <Style x:Key="Titre3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
    </Style>
    <Style x:Key="StyleTexteDiscret" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TexteDiscret}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Libelle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="TexteErreur" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="2,6,0,0" />
    </Style>

    <!-- ===================== Icône ===================== -->
    <Style x:Key="Icone" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Cartes ===================== -->
    <Style x:Key="StyleCarte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Carte}" />
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24,22" />
    </Style>

    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{StaticResource AvatarFond}" />
    </Style>
    <Style x:Key="StyleAvatarTexte" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource AvatarTexte}" />
    </Style>

    <Style x:Key="PastilleVerte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VertClair}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PastilleOrange" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OrangeClair}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Boutons ===================== -->
    <Style x:Key="BoutonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Police}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource Bordeaux}" />
        <Setter Property="BorderBrush" Value="{StaticResource Bordeaux}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BordeauxFonce}" />
                <Setter Property="BorderBrush" Value="{StaticResource BordeauxFonce}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonDangerPlein" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerFonce}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerFonce}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource Carte}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordureForte}" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Survol}" />
                <Setter Property="BorderBrush" Value="{StaticResource BordureSurvol}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonContour" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="{StaticResource Carte}" />
        <Setter Property="BorderBrush" Value="{StaticResource Bordeaux}" />
        <Setter Property="Foreground" Value="{StaticResource Bordeaux}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BordeauxClair}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton blanc sur la barre bordeaux de sélection -->
    <Style x:Key="BoutonSurBordeaux" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource Bordeaux}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BordeauxClair}" />
                <Setter Property="BorderBrush" Value="{StaticResource BordeauxClair}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BoutonContourSurBordeaux" TargetType="Button" BasedOn="{StaticResource BoutonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BordeauxBordure}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BordeauxFonce}" />
                <Setter Property="BorderBrush" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonLien" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Police}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Bordeaux}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"
                            BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter x:Name="Contenu" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BordeauxFonce}" />
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource BordeauxClair}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoutonDanger" TargetType="Button" BasedOn="{StaticResource BoutonLien}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Bouton-carte (fond blanc, toute la zone cliquable) : responsable, enfants… -->
    <Style x:Key="BoutonCarte" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{StaticResource Fond}" CornerRadius="12" Padding="14,10"
                            BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource BordureForte}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boutons de la barre de titre -->
    <Style x:Key="BoutonFenetre" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="#ECE7E2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BoutonFermerFenetre" TargetType="Button" BasedOn="{StaticResource BoutonFenetre}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="Transparent" CornerRadius="0,8,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Fermeture}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Champs de saisie ===================== -->
    <Style x:Key="Champ" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Police}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="Background" Value="{StaticResource Carte}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordureForte}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource Texte}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Bordeaux}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Indication" Text="{TemplateBinding Tag}" Foreground="{StaticResource TexteDiscret}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="2,0,0,0"
                                       Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Indication" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource BordureSurvol}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChampMultiligne" TargetType="TextBox" BasedOn="{StaticResource Champ}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Champ de recherche : icône loupe intégrée -->
    <Style x:Key="ChampRecherche" TargetType="TextBox" BasedOn="{StaticResource Champ}">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" SnapsToDevicePixels="True">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Ico.recherche}" Style="{StaticResource Icone}" Stroke="{StaticResource TexteDiscret}"
                                  Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="Indication" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource TexteDiscret}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Indication" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource BordureSurvol}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Case à cocher agrandie -->
    <Style x:Key="Case" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Boite" Width="24" Height="24" CornerRadius="6" BorderThickness="2"
                                BorderBrush="{StaticResource BordureSurvol}" Background="White" VerticalAlignment="Top">
                            <Path x:Name="Coche" Data="{StaticResource Ico.valider}" Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Margin="4" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,1,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Boite" Property="Background" Value="{StaticResource Bordeaux}" />
                            <Setter TargetName="Boite" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                            <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Boite" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Boite" Property="BorderBrush" Value="{StaticResource Texte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Choix segmenté (Adulte / Enfant) -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fond" Background="White" BorderBrush="{StaticResource BordureForte}" BorderThickness="2"
                            CornerRadius="12" Padding="18,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource BordeauxClair}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                            <Setter Property="Foreground" Value="{StaticResource Bordeaux}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Liste" TargetType="ComboBox">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="Date" TargetType="DatePicker">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BordureForte}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="SelectedDateFormat" Value="Short" />
    </Style>

    <!-- Barre de progression arrondie -->
    <Style x:Key="Progression" TargetType="ProgressBar">
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="7" Background="{StaticResource AvatarFond}" />
                        <Border x:Name="PART_Indicator" CornerRadius="7" Background="{StaticResource VertVif}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Élément de liste « carte » (liste des adhérents) -->
    <Style x:Key="ElementCarte" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Fond" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="2"
                            CornerRadius="14" Padding="14,10" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource BordureSurvol}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{StaticResource Texte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fenêtres : fond, police et lissage communs -->
    <Style x:Key="FenetreIca" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Police}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="Background" Value="{StaticResource Fond}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
</ResourceDictionary>
