<UserControl x:Class="ICA.Desktop.Vues.VueAccueil"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,52,40,32">

            <!-- En-tête -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding DateDuJour}" Style="{StaticResource StyleTexteDiscret}" FontSize="16" />
                    <TextBlock Text="{Binding Salutation}" FontSize="34" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox Grid.Column="1" Style="{StaticResource ChampRecherche}" Tag="Rechercher un adhérent…"
                         Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom"
                         AutomationProperties.Name="Rechercher un adhérent">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RechercherCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <!-- Chiffres clés -->
            <UniformGrid Columns="5" Margin="0,28,0,0">
                <Border Style="{StaticResource StyleCarte}" Margin="0,0,16,0" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.Total}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Bordeaux}" />
                        <TextBlock Text="Adhérents" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StyleCarte}" Margin="0,0,16,0" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.Adultes}" FontSize="40" FontWeight="Bold" />
                        <TextBlock Text="Adultes" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StyleCarte}" Margin="0,0,16,0" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.Enfants}" FontSize="40" FontWeight="Bold" />
                        <TextBlock Text="Enfants" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StyleCarte}" Margin="0,0,16,0" Padding="22,20">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.Payees}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource Vert}" />
                        <TextBlock Text="Cotisations payées" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StyleCarte}" Background="{StaticResource OrangeClair}" BorderBrush="{StaticResource OrangeBordure}"
                        BorderThickness="2" Padding="21,19">
                    <StackPanel>
                        <TextBlock Text="{Binding Stats.ARegler}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource OrangeVif}" />
                        <TextBlock Text="Cotisations à régler" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Orange}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Actions rapides -->
            <UniformGrid Columns="3" Margin="0,20,0,0">
                <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding AjouterCommand}" MinHeight="76"
                        HorizontalContentAlignment="Left" Padding="22,0" Margin="0,0,16,0" FontSize="18">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.plus}" Style="{StaticResource Icone}" Width="26" Height="26" StrokeThickness="2.4" />
                        <TextBlock Text="Ajouter un adhérent" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BoutonSecondaire}" Command="{Binding MessageCommand}" MinHeight="76"
                        HorizontalContentAlignment="Left" Padding="22,0" Margin="0,0,16,0" FontSize="18" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.messagerie}" Style="{StaticResource Icone}" Width="26" Height="26" Stroke="{StaticResource Bordeaux}" />
                        <TextBlock Text="Envoyer un message" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BoutonSecondaire}" Command="{Binding EncaisserCommand}" MinHeight="76"
                        HorizontalContentAlignment="Left" Padding="22,0" FontSize="18" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Ico.valider}" Style="{StaticResource Icone}" Width="26" Height="26" Stroke="{StaticResource Bordeaux}" />
                        <TextBlock Text="Encaisser une cotisation" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Listes -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StyleCarte}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonLien}" Content="Tout voir"
                                    Command="{Binding VoirCotisationsCommand}" />
                            <TextBlock Text="{Binding TitreARegler}" Style="{StaticResource Titre2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Toutes les cotisations sont réglées. Bravo !" Style="{StaticResource StyleTexteDiscret}" Margin="0,14,0,0"
                                   Visibility="{Binding RienARegler, Converter={StaticResource SiVrai}}" />
                        <ItemsControl ItemsSource="{Binding ARegler}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LigneAdherentCourte}">
                                    <Border BorderBrush="{StaticResource Separateur}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Avatar}">
                                                <TextBlock Text="{Binding Initiales}" Style="{StaticResource StyleAvatarTexte}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NomAffiche}" FontSize="17" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource BoutonContour}" Content="Marquer payée"
                                                    Command="{Binding Action}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                <Border Style="{StaticResource StyleCarte}" Margin="0,0,0,20">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonLien}" Content="Calendrier" Command="{Binding VoirCalendrierCommand}" />
                            <TextBlock Text="Cette semaine à L'ICA" Style="{StaticResource Titre2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Rien de prévu dans les 7 prochains jours." Style="{StaticResource StyleTexteDiscret}" Margin="0,12,0,0"
                                   Visibility="{Binding SemaineVide, Converter={StaticResource SiVrai}}" />
                        <ItemsControl ItemsSource="{Binding Semaine}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LigneSemaine}">
                                    <DockPanel Margin="0,8,0,0">
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Couleur}" VerticalAlignment="Top" Margin="0,7,10,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Horaire}" Style="{StaticResource StyleTexteDiscret}" />
                                        <StackPanel>
                                            <TextBlock x:Name="Nom" Text="{Binding Nom}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Quand}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EstAnnulee}" Value="True">
                                            <Setter TargetName="Nom" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="Nom" Property="Foreground" Value="{StaticResource TexteDiscret}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StyleCarte}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ico.gateau}" Style="{StaticResource Icone}" Stroke="#C2410C" />
                            <TextBlock Text="Anniversaires de la semaine" Style="{StaticResource Titre2}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Aucun anniversaire dans les 7 prochains jours." Style="{StaticResource StyleTexteDiscret}" Margin="0,14,0,0"
                                   Visibility="{Binding AucunAnniversaire, Converter={StaticResource SiVrai}}" />
                        <ItemsControl ItemsSource="{Binding Anniversaires}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LigneAnniversaire}">
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quand}" Style="{StaticResource StyleTexteDiscret}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding NomAffiche}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Age}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
