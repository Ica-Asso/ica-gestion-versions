<UserControl x:Class="ICA.Desktop.Vues.VueParametres"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,52,40,32" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource Titre1}" />

            <Border Style="{StaticResource StyleCarte}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Compte Google et synchronisation" Style="{StaticResource Titre2}" />

                    <TextBlock Style="{StaticResource StyleTexteDiscret}" FontSize="16" Margin="0,6,0,0"
                               Visibility="{Binding GoogleNonConfigure, Converter={StaticResource SiVrai}}"
                               Text="La connexion Google n'est pas encore installée sur cet ordinateur (fichier google-client.json manquant)." />

                    <StackPanel Visibility="{Binding GoogleDeconnecte, Converter={StaticResource SiVrai}}">
                        <TextBlock Style="{StaticResource StyleTexteDiscret}" FontSize="16" Margin="0,6,0,0"
                                   Text="Reliez votre compte Google : vos adhérents sont alors synchronisés automatiquement entre vos ordinateurs (via votre Google Drive), et les messages partent directement depuis votre Gmail." />
                        <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding ConnecterGoogleCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <TextBlock Text="Se connecter avec Google" />
                        </Button>
                        <TextBlock Style="{StaticResource StyleTexteDiscret}" FontSize="14" Margin="0,10,0,0"
                                   Text="Votre navigateur va s'ouvrir. Si Google affiche « Google n'a pas validé cette application », cliquez sur « Paramètres avancés » puis « Accéder à L'ICA Gestion » : c'est normal pour une application privée." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding GoogleConnecte, Converter={StaticResource SiVrai}}">
                        <TextBlock FontSize="16" Margin="0,8,0,0">
                            <Run Text="Connecté :" Foreground="{StaticResource TexteDiscret}" />
                            <Run Text="{Binding EmailGoogle, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Text="{Binding TexteSynchro}" Style="{StaticResource StyleTexteDiscret}" FontSize="15" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource BoutonSecondaire}" Content="Synchroniser maintenant" Command="{Binding SynchroniserCommand}"
                                    FontWeight="Bold" Margin="0,0,12,0" />
                            <Button Style="{StaticResource BoutonDanger}" Content="Se déconnecter" Command="{Binding DeconnecterGoogleCommand}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonSecondaire}" Content="Modifier" Command="{Binding ModifierAssociationCommand}"
                            VerticalAlignment="Top" FontWeight="Bold" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Association et reçus fiscaux" Style="{StaticResource Titre2}" />
                        <TextBlock Text="{Binding TexteAssociation}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TexteStatutFiscal}" Style="{StaticResource StyleTexteDiscret}" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource OrangeClair}" CornerRadius="999" Padding="14,6" VerticalAlignment="Top"
                            Visibility="{Binding EstDemo, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="Démonstration" FontWeight="Bold" Foreground="{StaticResource Orange}" FontSize="15" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Mes adhérents" Style="{StaticResource Titre2}" />
                        <TextBlock Style="{StaticResource StyleTexteDiscret}" Margin="0,6,24,0" FontSize="16" Text="{Binding TexteCompte}" />
                        <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding ImporterCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <TextBlock Text="Importer mes adhérents (Excel)" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Données" Style="{StaticResource Titre2}" />
                    <TextBlock Text="Emplacement sur cet ordinateur" Style="{StaticResource StyleTexteDiscret}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding Emplacement, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontWeight="SemiBold" TextWrapping="Wrap" Padding="0" />
                    <TextBlock Text="{Binding DerniereCopie}" Style="{StaticResource StyleTexteDiscret}" Margin="0,10,0,0" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource BoutonPrincipal}" Content="Sauvegarder mes données" Command="{Binding SauvegarderCommand}" Margin="0,0,12,10" />
                        <Button Style="{StaticResource BoutonSecondaire}" Content="Restaurer une sauvegarde" Command="{Binding RestaurerCommand}" Margin="0,0,12,10" FontWeight="Bold" />
                        <Button Style="{StaticResource BoutonSecondaire}" Content="Ouvrir le dossier" Command="{Binding OuvrirDossierCommand}" Margin="0,0,12,10" />
                        <Button Style="{StaticResource BoutonSecondaire}" Content="Réinitialiser la démonstration" Command="{Binding ReinitialiserCommand}"
                                Foreground="{StaticResource Danger}" Margin="0,0,0,10" Visibility="{Binding EstDemo, Converter={StaticResource SiVrai}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Messagerie" Style="{StaticResource Titre2}" />
                    <TextBlock Text="Où ouvrir les messages préparés par L'ICA Gestion, sur cet ordinateur :" Style="{StaticResource StyleTexteDiscret}"
                               FontSize="16" Margin="0,6,0,14" />
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding MessagerieGmail}" Margin="0,0,8,0" MinHeight="64">
                            <StackPanel Margin="0,6">
                                <TextBlock Text="Gmail dans le navigateur" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Chrome, Firefox, Edge…" FontSize="13" FontWeight="Normal" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding MessagerieApplication}" Margin="8,0,0,0" MinHeight="64">
                            <StackPanel Margin="0,6">
                                <TextBlock Text="Mon application de messagerie" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Outlook, Courrier, Thunderbird…" FontSize="13" FontWeight="Normal" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock Text="Avec Gmail, restez connectée à votre compte Gmail dans le navigateur : le message s'ouvre déjà rempli, il ne reste qu'à cliquer sur Envoyer."
                               Style="{StaticResource StyleTexteDiscret}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Cotisations" Style="{StaticResource Titre2}" />
                    <TextBlock Margin="0,8,0,0" FontSize="16">
                        <Run Text="Saison en cours :" Foreground="{StaticResource TexteDiscret}" />
                        <Run Text="{Binding Saison, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="16">
                        <Run Text="Tarifs :" Foreground="{StaticResource TexteDiscret}" />
                        <Run Text="{Binding Tarifs, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPrincipal}" Content="Un problème ?" Command="{Binding AssistanceCommand}"
                            VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Assistance" Style="{StaticResource Titre2}" />
                        <TextBlock Margin="0,8,0,0" FontSize="16" TextWrapping="Wrap">
                            <Run Text="Les signalements sont envoyés à" Foreground="{StaticResource TexteDiscret}" />
                            <Run Text="{Binding EmailSupport, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource StyleCarte}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Version" Style="{StaticResource Titre2}" />
                    <TextBlock Margin="0,8,0,0" FontSize="16">
                        <Run Text="L'ICA Gestion" Foreground="{StaticResource TexteDiscret}" />
                        <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button Style="{StaticResource BoutonSecondaire}" Content="Rechercher une mise à jour" Command="{Binding RechercherMiseAJourCommand}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
