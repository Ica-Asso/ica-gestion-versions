<UserControl x:Class="ICA.Desktop.Vues.VueActivites"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ICA.Client.ViewModels;assembly=ICA.Client">
    <UserControl.Resources>
        <!-- Une séance dans le panneau de droite / la liste -->
        <DataTemplate x:Key="ModeleSeance" DataType="{x:Type vm:DetailSeance}">
            <Border x:Name="Cadre" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="1" CornerRadius="14"
                    Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Background="{Binding Couleur}" Margin="0,2,12,2" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource PastilleOrange}" VerticalAlignment="Top"
                                Visibility="{Binding EstAnnulee, Converter={StaticResource SiVrai}}">
                            <TextBlock Text="Annulée" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Orange}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Quand}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Bordeaux}"
                                       Visibility="{Binding Quand, Converter={StaticResource SiRempli}}" />
                            <TextBlock x:Name="Nom" Text="{Binding Nom}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock FontSize="15" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap">
                                <Run Text="{Binding Horaire, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Lieu, Mode=OneWay, StringFormat=' · {0}'}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Participants}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                            <TextBlock Text="{Binding Notes}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" FontStyle="Italic"
                                       Visibility="{Binding Notes, Converter={StaticResource SiRempli}}" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="18,10,0,0">
                        <Button Style="{StaticResource BoutonLien}" Content="{Binding TexteEcrire}" Command="{Binding Ecrire}" FontSize="14" Margin="0,0,8,0" />
                        <Button Style="{StaticResource BoutonLien}" Content="Modifier" Command="{Binding Modifier}" FontSize="14" Margin="0,0,8,0" />
                        <Button Style="{StaticResource BoutonLien}" Content="{Binding TexteAnnulation}" Command="{Binding BasculerAnnulation}" FontSize="14" Margin="0,0,8,0" />
                        <Button Style="{StaticResource BoutonDanger}" Content="Supprimer" Command="{Binding Supprimer}" FontSize="14" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding EstAnnulee}" Value="True">
                    <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Fond}" />
                    <Setter TargetName="Nom" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Nom" Property="Foreground" Value="{StaticResource TexteDiscret}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="40,52,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre, bascule de vue, planifier -->
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPrincipal}" Command="{Binding PlanifierCommand}" MinHeight="52">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Ico.plus}" Style="{StaticResource Icone}" StrokeThickness="2.4" />
                    <TextBlock Text="Planifier une activité" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonSecondaire}" Command="{Binding NouvelleActiviteCommand}"
                    Content="Nouvelle activité" Margin="0,0,12,0" FontWeight="Bold" />
            <TextBlock Text="Activités" Style="{StaticResource Titre1}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Segment}" Content="Calendrier" IsChecked="{Binding VueCalendrier}" MinHeight="44" Margin="0,0,8,0" />
                <RadioButton Style="{StaticResource Segment}" Content="Activités et participants" IsChecked="{Binding VueListe}" MinHeight="44" />
            </StackPanel>
        </DockPanel>

        <!-- ================= Vue calendrier ================= -->
        <Grid Grid.Row="1" Visibility="{Binding VueCalendrier, Converter={StaticResource SiVrai}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StyleCarte}" Padding="20,18">
                <DockPanel>
                    <!-- Navigation mois -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BoutonSecondaire}" Content="Aujourd'hui" Command="{Binding AujourdhuiCommand}"
                                    MinHeight="44" FontSize="15" Margin="0,0,10,0" />
                            <Button Style="{StaticResource BoutonSecondaire}" Content="‹" Command="{Binding MoisPrecedentCommand}" MinHeight="44"
                                    FontSize="22" Padding="16,0" Margin="0,0,6,0" ToolTip="Mois précédent" AutomationProperties.Name="Mois précédent" />
                            <Button Style="{StaticResource BoutonSecondaire}" Content="›" Command="{Binding MoisSuivantCommand}" MinHeight="44"
                                    FontSize="22" Padding="16,0" ToolTip="Mois suivant" AutomationProperties.Name="Mois suivant" />
                        </StackPanel>
                        <TextBlock Text="{Binding TitreMois}" Style="{StaticResource Titre2}" FontSize="24" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Jours de la semaine -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding JoursSemaine}" Focusable="False" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TexteDiscret}" Margin="8,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Grille du mois -->
                    <ItemsControl ItemsSource="{Binding Jours}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:JourCalendrier}">
                                <Button Command="{Binding Choisir}" Margin="2" Cursor="Hand" MinHeight="84">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Case" Background="White" BorderBrush="{StaticResource Separateur}" BorderThickness="2"
                                                    CornerRadius="10" Padding="6,4">
                                                <StackPanel>
                                                    <Border x:Name="Rond" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left"
                                                            Background="Transparent">
                                                        <TextBlock x:Name="Numero" Text="{Binding Numero}" FontSize="14" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Texte}" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Puces}" Focusable="False" Margin="0,2,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:PuceSeance}">
                                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding Couleur}" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="Texte" Text="{Binding Texte}" FontSize="12" Margin="5,0,0,0"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="110" Foreground="{StaticResource TexteSecondaire}" />
                                                                </StackPanel>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding EstAnnulee}" Value="True">
                                                                        <Setter TargetName="Texte" Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter TargetName="Texte" Property="Foreground" Value="{StaticResource TexteDiscret}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Plus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Bordeaux}"
                                                               Visibility="{Binding Plus, Converter={StaticResource SiRempli}}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding EstDuMois}" Value="False">
                                                    <Setter TargetName="Case" Property="Background" Value="{StaticResource Fond}" />
                                                    <Setter TargetName="Case" Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource BordureSurvol}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EstAujourdhui}" Value="True">
                                                    <Setter TargetName="Rond" Property="Background" Value="{StaticResource Bordeaux}" />
                                                    <Setter TargetName="Numero" Property="Foreground" Value="White" />
                                                    <Setter TargetName="Numero" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstChoisi}" Value="True">
                                                    <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                                                    <Setter TargetName="Case" Property="Background" Value="{StaticResource BordeauxClair}" />
                                                    <Setter TargetName="Case" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource Texte}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Jour choisi -->
            <Border Grid.Column="2" Style="{StaticResource StyleCarte}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="22">
                        <TextBlock Text="{Binding TitreJour}" Style="{StaticResource Titre2}" FontSize="22" />
                        <TextBlock Text="Rien de prévu ce jour-là." Style="{StaticResource StyleTexteDiscret}" Margin="0,10,0,0"
                                   Visibility="{Binding JourVide, Converter={StaticResource SiVrai}}" />
                        <ItemsControl ItemsSource="{Binding SeancesDuJour}" ItemTemplate="{StaticResource ModeleSeance}" Margin="0,14,0,0" Focusable="False" />
                        <Button Style="{StaticResource BoutonContour}" Content="+ Planifier ce jour-là" Command="{Binding PlanifierCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <Border BorderBrush="{StaticResource Separateur}" BorderThickness="0,1,0,0" Margin="0,22,0,16" />
                        <TextBlock Text="Prochainement" Style="{StaticResource Titre3}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Prochaines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DetailSeance}">
                                    <DockPanel Margin="0,0,0,10">
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Couleur}" VerticalAlignment="Top" Margin="0,7,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource StyleTexteDiscret}" FontSize="14">
                                                <Run Text="{Binding Quand, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Horaire, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Vue activités et participants ================= -->
        <Grid Grid.Row="1" Visibility="{Binding VueListe, Converter={StaticResource SiVrai}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding ListeActivites}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ElementActivite}">
                            <Button Command="{Binding Choisir}" Margin="0,0,0,10" Cursor="Hand" AutomationProperties.Name="{Binding Nom}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Cadre" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="2"
                                                CornerRadius="14" Padding="16,14">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="7" Background="{Binding Couleur}"
                                                        VerticalAlignment="Top" Margin="0,5,12,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nom}" FontSize="18" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource StyleTexteDiscret}" FontSize="14"
                                                               Visibility="{Binding Description, Converter={StaticResource SiRempli}}" />
                                                    <TextBlock Text="{Binding Resume}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                                               Foreground="{StaticResource TexteSecondaire}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource BordureSurvol}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding EstChoisi}" Value="True">
                                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordeaux}" />
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Texte}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource StyleCarte}" Padding="0"
                    Visibility="{Binding AActiviteChoisie, Converter={StaticResource SiVrai}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="26">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonLien}" Content="Modifier l'activité"
                                    Command="{Binding ModifierActiviteCommand}" FontSize="15" VerticalAlignment="Top" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{Binding ActiviteChoisie.Couleur}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiviteChoisie.Nom}" Style="{StaticResource Titre2}" FontSize="26" Margin="12,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding ActiviteChoisie.Resume}" Style="{StaticResource StyleTexteDiscret}" FontSize="16" Margin="30,2,0,0" />

                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource BoutonPrincipal}" Content="Écrire aux participants" Command="{Binding EcrireParticipantsCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource BoutonSecondaire}" Content="Imprimer la liste" Command="{Binding ImprimerParticipantsCommand}" FontWeight="Bold" />
                        </WrapPanel>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Participants" Style="{StaticResource Titre3}" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource StyleTexteDiscret}" Visibility="{Binding AucunParticipant, Converter={StaticResource SiVrai}}"
                                           Text="Personne n'est encore inscrit. Les inscriptions se font depuis la fiche de chaque adhérent (bouton « Modifier »)." />
                                <ItemsControl ItemsSource="{Binding Participants}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LigneParticipant}">
                                            <Border BorderBrush="{StaticResource Separateur}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <DockPanel>
                                                    <Border Style="{StaticResource Avatar}" Width="38" Height="38" CornerRadius="19">
                                                        <TextBlock Text="{Binding Initiales}" Style="{StaticResource StyleAvatarTexte}" FontSize="13" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NomAffiche}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource StyleTexteDiscret}" FontSize="14" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prochaines séances" Style="{StaticResource Titre3}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding SeancesActivite}" ItemTemplate="{StaticResource ModeleSeance}" Focusable="False" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
