<UserControl x:Class="ICA.Desktop.Vues.VueEnPreparation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,52,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Titre}" Style="{StaticResource Titre1}" />
        <Border Grid.Row="1" Style="{StaticResource StyleCarte}" MaxWidth="620" VerticalAlignment="Center" Padding="40,36">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource BordeauxClair}" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Ico.chantier}" Style="{StaticResource Icone}" Width="30" Height="30"
                          Stroke="{StaticResource Bordeaux}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Bientôt disponible" Style="{StaticResource Titre2}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" FontSize="17" Margin="0,12,0,0"
                           Foreground="{StaticResource TexteSecondaire}" />
                <Border Background="{StaticResource Fond}" CornerRadius="12" Padding="18,14" Margin="0,22,0,0">
                    <TextBlock Text="{Binding EnAttendant}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15"
                               Foreground="{StaticResource TexteSecondaire}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
